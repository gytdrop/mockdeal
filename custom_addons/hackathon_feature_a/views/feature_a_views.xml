<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hackathon_item_form_inherit_a" model="ir.ui.view">
        <field name="name">hackathon.item.form.inherit.a</field>
        <field name="model">hackathon.item</field>
        <field name="inherit_id" ref="hackathon_core.view_hackathon_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="feature_a_score"/>
            </xpath>
        </field>
    </record>
</odoo>
